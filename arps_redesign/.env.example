# ─────────────────────────────────────────────────────────────
# ARPS — Environment Variables
# ─────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file and rename the copy to:   .env
#   2. Fill in your MySQL password below
#   3. Save the file — the app reads it automatically on startup
# ─────────────────────────────────────────────────────────────

# Your MySQL root password (leave empty if MySQL has no password)
DB_PASSWORD=

# MySQL username (usually root for local development)
DB_USER=root

# MySQL host and port (leave as-is for local MySQL)
DB_HOST=localhost
DB_PORT=3306

# Database name (must match what you created in MySQL)
DB_NAME=arps_db

# Flask secret key (change this to anything random for production)
SECRET_KEY=arps-secret-key-change-me

# Institutional passkey required when an admin registers
ADMIN_PASSKEY=DEPT-CS-ADMIN-2026

# ── Email / SMTP Settings ────────────────────────────────────
# Required for result notification emails to students

# Gmail setup:
#   1. Enable 2-Factor Authentication on your Gmail account
#   2. Go to: Google Account → Security → App Passwords
#   3. Create a new App Password → copy it here
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=your_16_char_app_password

# The "From" name shown in student inboxes
MAIL_DEFAULT_SENDER=IBB University ARPS <your.email@gmail.com>

# Set to true to test without actually sending (preview mode)
MAIL_SUPPRESS_SEND=false

# ── QR Verification URL ─────────────────────────────────────
# Set this to your machine's IP so QR codes work when scanned by phone.
# Find your IP: run   ipconfig   (Windows) or   ifconfig   (Linux/Mac)
# Example: if your IP is 192.168.1.50 and Flask runs on port 5000:
SERVER_URL=http://192.168.1.50:5000

# For production/public deployment:
# SERVER_URL=https://arps.ibbul.edu.ng
